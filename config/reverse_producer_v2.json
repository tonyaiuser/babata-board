{
  "schema": "spspy-reverse-producer/v2",
  "workflow": {
    "repository": "tonyaiuser/babata-board",
    "path": ".github/workflows/trusted-reverse-producer-v2.yml",
    "authority_ref": "refs/heads/main",
    "signer_workflow_ref": "tonyaiuser/babata-board/.github/workflows/trusted-reverse-producer-v2.yml@refs/heads/main",
    "blob_oid": null
  },
  "limits": {
    "max_file_bytes": 67108864,
